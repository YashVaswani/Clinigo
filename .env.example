# LiveKit Connection Settings
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# LLM Provider Keys
GOOGLE_API_KEY=your-gemini-key
GROQ_API_KEY=your-groq-key

# Database Connection (Supabase or Neon PostgreSQL URL)
# Example: postgresql://postgres:password@db.supabase.co:5432/postgres
DATABASE_URL=your-database-connection-url

# Provider Local Endpoints (For local free stack)
WHISPER_URL=http://localhost:8000/v1
KOKORO_URL=http://localhost:8880/v1
OLLAMA_URL=http://localhost:11434/v1

# Cartesia TTS Settings
CARTESIA_API_KEY=your-cartesia-api-key
CARTESIA_VOICE_ID=

